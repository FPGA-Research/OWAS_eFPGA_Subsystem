# ==============================================================================
# CrocoScale SoC — .gitignore
# ==============================================================================

# AI Scratchpad, Workspace & Notes (kept local, never published to git)
gemini.md
gemini_workspace/
CrocoScale_BusKit/
workspace/
.gemini/
.agents/

# VS Code Artifacts & Local Workspace Configuration
.vscode/
*.code-workspace
*.workspace

# Vivado Projects, Temporary Files, Databases & Logs
*.jou
*.log
*.pb
*.str
*.vds
*.dcp
*.wdb
.Xil/
hd_visual/
vivado_project/
*.runs/
*.gen/
*.sim/
*.cache/
*.hw/
*.ip_user_files/

# Simulation Waveforms & Dumps
*.vcd
*.fst
*.ghw
dump.vcd
*.out
a.out

# Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
pyenv/

# C / C++ / Build Output
*.o
*.obj
*.exe
*.so
*.dll
build/
SOFT_LOGIC/build/
tools/

# OS Artifacts & Editor Backups
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Generated Verilog Mirror (reproducible from scripts/)
VERILOG_MIRROR_GENERATED/

# LibreLane Run Directories
RUNS/
runs/
# VERILOG_FILES generated from the filelists (scripts/filelist_to_librelane.py)
librelane/*/verilog_files.json
# eFPGA LEF generated from the fabric views (scripts/efpga_tm1_obs_lef.py)
librelane/efpga_subsystem_top/eFPGA_interface/eFPGA_tm1bands.lef

# bin files
*.bin

